# Production settings. Copy to .env.production ON THE SERVER and fill in.
# Never commit .env.production.
#
#   cp .env.production.example .env.production && nano .env.production

# --- Your address -----------------------------------------------------------
# The domain pointing at this server, e.g. armypassion.in
# (Use ":80" only to try it on your own computer without HTTPS.)
SITE_ADDRESS=armypassion.example.in
# Let's Encrypt sends certificate warnings here.
ACME_EMAIL=you@example.com

# --- The site password (until real login is built) -------------------------
BASIC_AUTH_USER=colonel
# Make the hash on the server (replace the password), then paste it here:
#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'YOUR-PASSWORD' | base64 -w0
BASIC_AUTH_HASH=

# --- Database ---------------------------------------------------------------
# Letters and digits only. Make one with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# --- App ----------------------------------------------------------------------
# Make one with:  openssl rand -hex 32
SECRET_KEY=
TIMEZONE=Asia/Kolkata

# Shown in the top-left of the screens (built in when the frontend is built).
NEXT_PUBLIC_USER_NAME=Demo User
NEXT_PUBLIC_USER_ROLE=Administrator

# --- External services (all mock during this phase) -------------------------
WHATSAPP_PROVIDER=mock
SPEECH_TO_TEXT_PROVIDER=mock
TRANSLATION_PROVIDER=mock
LLM_PROVIDER=mock
ESIGN_PROVIDER=mock
GEOCODING_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=

# --- File storage -------------------------------------------------------------
# "local" keeps uploaded documents in a Docker volume on this server.
# "s3" (DigitalOcean Spaces) is not built yet; these are placeholders.
STORAGE_PROVIDER=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=blr1

# --- Ports (leave as they are on a server) ----------------------------------
HTTP_PORT=80
HTTPS_PORT=443
