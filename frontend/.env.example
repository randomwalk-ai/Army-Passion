# Copy to frontend/.env.local and change as needed.

# Where the backend API runs.
NEXT_PUBLIC_API_URL=http://localhost:8010

# Shown in the menu and on Home until login exists. Placeholder only.
NEXT_PUBLIC_USER_NAME=Demo User
NEXT_PUBLIC_USER_ROLE=Administrator

# Error reporting to sentry.io. Leave EMPTY on your own computer (nothing is
# sent); set only on the live site. Fixed when the app is built.
NEXT_PUBLIC_SENTRY_DSN=
