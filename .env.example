# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# Port 5434 (not 5432) so it does not clash with other PostgreSQL containers on this machine.
DATABASE_URL=postgresql+psycopg://army:army_dev_password@localhost:5434/army_passion

# --- Redis (Celery broker + result backend) ---
REDIS_URL=redis://localhost:6380/0

# --- App ---
APP_ENV=development
TIMEZONE=Asia/Kolkata
SECRET_KEY=change-me-in-production

# --- External services ---
# "mock" uses the fake in-process implementation. "real" switches to the live provider.
# During the current phase everything stays on "mock".
WHATSAPP_PROVIDER=mock
SPEECH_TO_TEXT_PROVIDER=mock
TRANSLATION_PROVIDER=mock
LLM_PROVIDER=mock
ESIGN_PROVIDER=mock
GEOCODING_PROVIDER=mock
STORAGE_PROVIDER=local

# --- Credentials for the real providers (leave blank while on mock) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

BHASHINI_API_KEY=
SARVAM_API_KEY=

# The LLM is used to work out what an unfamiliar column heading means (only the
# headings are sent), and to turn a typed question on the Assistant into a
# database search (only the question and table/column names are sent; the
# answers stay on this machine).
# Set LLM_PROVIDER above to "gemini" and fill these in to switch it on.
# Get a key from https://aistudio.google.com/apikey
LLM_API_KEY=
# Leave blank to use the default. Google retires older models, so if you see
# a 404 saying a model is "no longer available", put a current name here.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

ESIGN_API_KEY=

# --- Error reporting (sentry.io) ---
# Leave EMPTY on your own computer: nothing is sent. Set it only on the live
# site (Render), from the Sentry project's Settings -> Client Keys (DSN).
# No family details are ever sent (see backend/app/services/error_reporting.py).
SENTRY_DSN=

# --- Storage ---
# Used when STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
# Used when STORAGE_PROVIDER=s3 (DigitalOcean Spaces later). Placeholders for now:
# the S3 storage class is not built yet, so keep STORAGE_PROVIDER=local.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=blr1
